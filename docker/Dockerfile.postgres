# PostGIS + pgvector in one image so geospatial filters and vector search
# run against the same database. Built locally; production uses the same recipe.
FROM pgvector/pgvector:pg16

RUN apt-get update \
  && apt-get install -y --no-install-recommends postgis postgresql-16-postgis-3 \
  && rm -rf /var/lib/apt/lists/*
