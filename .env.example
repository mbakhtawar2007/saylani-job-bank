# ─── App ────────────────────────────────────────────────────────────────
# SECURITY: this file is tracked in git. It must contain ONLY placeholders —
# never real passwords, secrets or keys. Copy it to .env and fill in real,
# locally generated values there (.env is gitignored). Every value that was
# previously in this file has been rotated: the old dev passwords/secret are
# compromised (they were committed to git history) and must not be reused.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Map tiles (leave unset to use public OpenStreetMap tiles — development only)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# OpenCage geocoding API key — get one free at https://opencagedata.com
NEXT_PUBLIC_OPENCAGE_API_KEY=

# ─── Database ───────────────────────────────────────────────────────────
# Runtime connection (restricted role: no UPDATE/DELETE on append-only tables)
DATABASE_URL=postgres://app_rw:<change-me>@localhost:5433/jobbank
# Owner connection used only by migrations and seeds
DATABASE_MIGRATOR_URL=postgres://jobbank:<change-me>@localhost:5433/jobbank

# ─── Object storage (S3 compatible — SeaweedFS locally) ─────────────────
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<change-me>
S3_SECRET_ACCESS_KEY=<change-me>
S3_BUCKET=jobbank-documents
S3_FORCE_PATH_STYLE=true

# ─── Redis (optional in Phase 1 — leave empty to disable) ───────────────
REDIS_URL=redis://localhost:6380

# ─── Email (Mailpit locally: UI at http://localhost:8025) ───────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Saylani Job Bank <no-reply@jobbank.local>"
# smtp (default) or memory. SMTP_USER / SMTP_PASSWORD / SMTP_SECURE for real providers.
MAIL_TRANSPORT=smtp

# ─── Auth ───────────────────────────────────────────────────────────────
# REQUIRED in every environment (no dev fallback secret exists any more).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
# Local dev seed password (≥10 chars): the single password for all seeded
# dev/test accounts. Generate one locally, e.g. openssl rand -base64 18, and
# put the SAME value in .env. Never commit a real value; never reuse the old
# committed one. CI generates a fresh ephemeral value per run (see ci.yml).
SEED_DEV_PASSWORD=<change-me-min-10-chars>
# OTP SMS gateway: 'console' prints codes to the dev server log (production provider: TBD)
SMS_PROVIDER=console

# ─── Geocoding (OpenCage) ────────────────────────────────────────────────
# Optional. Provides high-precision Pakistani address & area search (opencagedata.com)
OPENCAGE_API_KEY=


# Auto matching engine (Python service: services/matching)
MATCHING_DATABASE_URL=postgres://jobbank:<change-me>@localhost:5433/jobbank
MATCHING_HOST=0.0.0.0
MATCHING_PORT=8000
MATCHING_WORKER_ENABLED=true
MATCHING_WORKER_POLL_SECONDS=2
# LISTEN/NOTIFY: worker wakes in ~ms when an outbox event lands (poll is fallback)
MATCHING_WORKER_NOTIFY_ENABLED=true
# Redis profile cache (fail-open: Redis trouble never fails a run)
MATCHING_REDIS_URL=redis://localhost:6380/0
MATCHING_CACHE_ENABLED=true
MATCHING_CACHE_TTL_SECONDS=600
# Phase 3: semantic skill matching (needs scripts/backfill_embeddings.py first)
MATCHING_SEMANTIC_ENABLED=true
MATCHING_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
