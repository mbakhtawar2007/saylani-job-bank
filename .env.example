# ─── App ────────────────────────────────────────────────────────────────
# SECURITY: this file is tracked in git. It must contain ONLY placeholders —
# never real passwords, secrets or keys. Copy it to .env and fill in real,
# locally generated values there (.env is gitignored). Every value that was
# previously in this file has been rotated: the old dev passwords/secret are
# compromised (they were committed to git history) and must not be reused.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Trusted proxies in front of the app: how many right-hand entries of
# X-Forwarded-For to trust for the client IP (1 behind a single nginx,
# 2 behind Cloudflare + nginx). The app runs with no proxy locally, so
# leave at 1; a wrong (too high) value lets a client spoof its IP.
TRUSTED_PROXY_HOPS=1
# Map tiles (leave unset to use public OpenStreetMap tiles — development only)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# OpenCage geocoding API key — get one free at https://opencagedata.com
NEXT_PUBLIC_OPENCAGE_API_KEY=

# ─── Database ───────────────────────────────────────────────────────────
# Runtime connection (restricted role: no UPDATE/DELETE on append-only tables)
DATABASE_URL=postgres://app_rw:<change-me>@localhost:5433/jobbank
# Owner connection used only by migrations and seeds
DATABASE_MIGRATOR_URL=postgres://jobbank:<change-me>@localhost:5433/jobbank
# Compose passwords (REQUIRED — `docker compose up` fails fast without them;
# there are no default passwords any more). The passwords in the two URLs
# above MUST match these values, or the app cannot connect to its own DB:
# DATABASE_URL's password = APP_RW_PASSWORD, DATABASE_MIGRATOR_URL's = POSTGRES_PASSWORD.
# Generate with: openssl rand -base64 18 (no spaces — values are interpolated
# into SQL and command lines by compose).
POSTGRES_PASSWORD=<change-me>
APP_RW_PASSWORD=<change-me>

# ─── Object storage (S3 compatible — SeaweedFS locally) ─────────────────
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
# These two double as the SeaweedFS S3 identity in docker-compose.yml — the
# app and the local object store share them. Generate with: openssl rand -base64 18
S3_ACCESS_KEY_ID=<change-me>
S3_SECRET_ACCESS_KEY=<change-me>
S3_BUCKET=jobbank-documents
S3_FORCE_PATH_STYLE=true

# ─── Redis (optional in Phase 1 — leave empty to disable) ───────────────
# The compose Redis requires a password (REDIS_PASSWORD). Paste the SAME value
# into REDIS_URL — .env does not expand ${...} here, so the two must be kept in
# sync by hand. If REDIS_URL has no (or a wrong) password, the app logs a
# warning and silently falls back to in-memory rate limits.
REDIS_PASSWORD=<change-me>
REDIS_URL=redis://:<change-me>@127.0.0.1:6380

# ─── Email (Mailpit locally: UI at http://localhost:8025) ───────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Saylani Job Bank <no-reply@jobbank.local>"
# smtp (default) or memory. SMTP_USER / SMTP_PASSWORD / SMTP_SECURE for real providers.
# For local Mailpit, SMTP_USER / SMTP_PASSWORD must be the MP_SMTP_AUTH pair
# below (the app authenticates when SMTP_USER is set). The UI/API login is
# MP_UI_AUTH. Generate passwords with: openssl rand -base64 18
MAILPIT_UI_AUTH=mailpit-admin:<change-me>
MAILPIT_SMTP_AUTH=mailpit:<change-me>
SMTP_USER=mailpit
SMTP_PASSWORD=<change-me>
MAIL_TRANSPORT=smtp

# ─── Auth ───────────────────────────────────────────────────────────────
# REQUIRED in every environment (no dev fallback secret exists any more).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
# Local dev seed password (≥10 chars): the single password for all seeded
# dev/test accounts. Generate one locally, e.g. openssl rand -base64 18, and
# put the SAME value in .env. Never commit a real value; never reuse the old
# committed one. CI generates a fresh ephemeral value per run (see ci.yml).
SEED_DEV_PASSWORD=<change-me-min-10-chars>
# Set SEED_DEV_DATA=true to include the seeded dev branches/accounts when you
# run `pnpm db:seed`. Default is OFF (opt-in): without it, seed creates only
# reference + master data and no sign-in accounts. Integration tests always
# seed dev data (they sign in with those accounts) regardless of this flag.
SEED_DEV_DATA=false
# OTP SMS gateway: 'console' prints codes to the dev server log (production provider: TBD)
SMS_PROVIDER=console

# ─── Geocoding (OpenCage) ────────────────────────────────────────────────
# Optional. Provides high-precision Pakistani address & area search (opencagedata.com)
OPENCAGE_API_KEY=

# ─── Malware scanning (uploads) ─────────────────────────────────────────
# Optional for now, REQUIRED before any production deployment: without a
# scanner, document confirm blocks every upload in production by design
# (see scansEnforced in apps/web/src/lib/s3/storage.ts). Development/test
# let unscanned uploads through with scanResult 'skipped' recorded.
# Point at a ClamAV sidecar (or equivalent) exposing POST {url}/scan with
# JSON { "key": "<object key>" } returning { "result": "clean" | "infected" }.
MALWARE_SCANNER_URL=


# Auto matching engine (Python service: services/matching)
MATCHING_DATABASE_URL=postgres://jobbank:<change-me>@localhost:5433/jobbank
MATCHING_HOST=0.0.0.0
MATCHING_PORT=8000
MATCHING_WORKER_ENABLED=true
MATCHING_WORKER_POLL_SECONDS=2
# LISTEN/NOTIFY: worker wakes in ~ms when an outbox event lands (poll is fallback)
MATCHING_WORKER_NOTIFY_ENABLED=true
# Redis profile cache (fail-open: Redis trouble never fails a run)
# Same password as REDIS_PASSWORD above (paste the value; .env does not expand ${...}).
MATCHING_REDIS_URL=redis://:<change-me>@127.0.0.1:6380/0
MATCHING_CACHE_ENABLED=true
MATCHING_CACHE_TTL_SECONDS=600
# Phase 3: semantic skill matching (needs scripts/backfill_embeddings.py first)
MATCHING_SEMANTIC_ENABLED=true
MATCHING_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
