{
  "name": "saylani-job-bank",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue && pnpm test:jest && pnpm test:e2e",
    "test:jest": "pnpm --filter @jobbank/web test:jest",
    "test:e2e": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit tests/e2e/cross-browser.spec.ts",
    "test:visual-verify": "playwright test tests/e2e/visual-ux.spec.ts --project=chromium",
    "test:visual-update": "playwright test tests/e2e/visual-ux.spec.ts --project=chromium --update-snapshots",
    "test:api-load": "artillery run tests/load-test.yml --output tests/reports/load-api.json",
    "test:web-load": "artillery run tests/web-load-test.yml --output tests/reports/load-web.json",
    "test:db-load": "node tests/db-test.js",
    "test:security": "audit-ci --moderate",
    "test:reports": "node tests/generate-report.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait postgres seaweedfs redis mailpit && docker compose run --rm s3-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && pnpm infra:up",
    "db:generate": "pnpm --filter @jobbank/db db:generate",
    "db:migrate": "pnpm --filter @jobbank/db db:migrate",
    "db:seed": "pnpm --filter @jobbank/db db:seed",
    "db:studio": "pnpm --filter @jobbank/db db:studio",
    "matching:dev": "node scripts/matching-python.mjs dev",
    "matching:test": "node scripts/matching-python.mjs test",
    "matching:install": "node scripts/matching-python.mjs install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "artillery": "^2.0.34",
    "audit-ci": "^7.1.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.2",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "retire": "^6.1.1",
    "ts-jest": "^29.4.15",
    "turbo": "^2.11.13",
    "typescript": "5.9.3"
  }
}
