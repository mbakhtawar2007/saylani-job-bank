+-- N13 (2026-11-08): drop the dead `willing_radius_m` column from
+-- `applicant_preferences`. The matching radius has lived in
+-- `match_radius_policies` since M5 (BRANCH scope, 10 km ceiling enforced by
+-- `match_radius_policies_range`); nothing in the app reads or writes this
+-- column — the only references were migration 0009 and one DB test asserting
+-- its CHECK. Dropping the column also drops its CHECK constraint
+-- `applicant_preferences_radius` (column-level CHECKs go with the column).
+-- Written by hand, not via `db:generate`, so the drop is explicit and
+-- reviewable. Next `db:generate` must emit nothing for this table.
+ALTER TABLE "applicant_preferences" DROP COLUMN "willing_radius_m";
diff --git a/packages/db/migrations/0037_job_matches_vacancy_filled.sql b/packages/db/migrations/0037_job_matches_vacancy_filled.sql
new file mode 100644
index 0000000..f7337c9
--- /dev/null
+++ b/packages/db/migrations/0037_job_matches_vacancy_filled.sql
@@ -0,0 +1,10 @@
+-- C3/H19 (2026-11-08): record, on the match row, whether this match's HIRED
+-- decision filled a vacancy (see syncMatchHire in
+-- apps/web/src/domains/matching/service.ts). The decline path frees the
+-- vacancy only when this flag is set — it is the proof that *this* match
+-- filled it, not a placement accept that happened first. Defaults to false
+-- for all existing rows (no past decline can retroactively free a vacancy),
+-- and the Python matching engine's INSERT lists its columns explicitly, so
+-- it keeps defaulting false there; the engine also preserves the flag across
+-- re-runs (see services/matching/app/repository.py).
+ALTER TABLE "job_matches" ADD COLUMN "vacancy_filled" boolean DEFAULT false NOT NULL;
